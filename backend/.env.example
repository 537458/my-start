# 环境变量配置示例
# 复制此文件为 .env 并根据实际情况修改

# ==================== 服务器配置 ====================
# 服务器端口
SERVER_PORT=8080

# ==================== JWT 配置 ====================
# JWT 密钥（生产环境必须修改为随机长字符串，至少32位）
JWT_SECRET=your_very_long_random_secret_key_here_min_32_chars

# JWT 过期时间（毫秒，默认 24 小时）
JWT_EXPIRATION=86400000

# ==================== 数据库配置 ====================
# 数据库连接URL
DB_URL=jdbc:mysql://localhost:3306/petshop?useUnicode=true&characterEncoding=utf-8&useSSL=false&serverTimezone=Asia/Shanghai&allowPublicKeyRetrieval=true

# 数据库用户名
DB_USERNAME=root

# 数据库密码（生产环境请使用强密码）
DB_PASSWORD=your_strong_password_here

# ==================== AI 配置 ====================
# 讯飞星火应用ID（请向项目负责人索取，切勿将真实密钥提交到仓库）
XUNFEI_APPID=your_xunfei_appid_here

# 讯飞星火API Key
XUNFEI_APIKEY=your_xunfei_apikey_here

# 讯飞星火API Secret
XUNFEI_APISECRET=your_xunfei_apisecret_here

# 讯飞星火API Password
XUNFEI_APIPASSWORD=your_xunfei_apipassword_here
