<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    android:background="@drawable/bg_payment_item"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="16dp"
    android:paddingTop="14dp"
    android:paddingEnd="16dp"
    android:paddingBottom="14dp">

    <!-- 支付方式图标：圆角色块 + 文字，避免依赖系统图标导致风格不一致 -->
    <TextView
        android:id="@+id/tv_payment_icon"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:gravity="center"
        android:text="微"
        android:textColor="@color/colorWhite"
        android:textSize="18sp"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tv_payment_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="微信支付"
            android:textColor="@color/colorTextPrimary"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/tv_payment_desc"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="推荐使用，安全快捷"
            android:textColor="@color/colorTextLight"
            android:textSize="12sp" />
    </LinearLayout>

    <ImageView
        android:id="@+id/iv_payment_check"
        android:layout_width="22dp"
        android:layout_height="22dp"
        android:contentDescription="已选中"
        android:src="@drawable/ic_payment_check"
        android:visibility="gone" />

</LinearLayout>
