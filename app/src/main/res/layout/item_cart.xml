<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    app:cardBackgroundColor="@color/colorWhite"
    app:cardCornerRadius="18dp"
    app:cardElevation="2dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="4dp"
        android:paddingTop="12dp"
        android:paddingEnd="12dp"
        android:paddingBottom="12dp">

        <!-- 选择框 -->
        <CheckBox
            android:id="@+id/cb_select"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:buttonTint="@color/colorPrimary"
            android:gravity="center" />

        <!-- 商品图片 -->
        <androidx.cardview.widget.CardView
            android:layout_width="88dp"
            android:layout_height="88dp"
            android:layout_marginStart="2dp"
            android:layout_marginEnd="12dp"
            app:cardBackgroundColor="@color/light_gray"
            app:cardCornerRadius="14dp"
            app:cardElevation="0dp">

            <ImageView
                android:id="@+id/iv_product"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="商品图片"
                android:scaleType="centerCrop"
                android:src="@drawable/ic_placeholder" />
        </androidx.cardview.widget.CardView>

        <!-- 商品信息 -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="top"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tv_product_name"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:lineSpacingExtra="2dp"
                    android:maxLines="2"
                    android:text="商品名称"
                    android:textColor="@color/colorTextPrimary"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <ImageView
                    android:id="@+id/tv_delete"
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:layout_marginStart="6dp"
                    android:background="@drawable/bg_icon_ripple"
                    android:contentDescription="删除商品"
                    android:padding="6dp"
                    android:src="@drawable/ic_delete"
                    app:tint="@color/colorTextLight" />
            </LinearLayout>

            <TextView
                android:id="@+id/tv_stock"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textColor="@color/orange"
                android:textSize="11sp"
                android:visibility="gone"
                tools:text="仅剩 3 件" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tv_product_price"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="¥0.00"
                    android:textColor="@color/colorPrimary"
                    android:textSize="17sp"
                    android:textStyle="bold" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_weight="1" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_qty_stepper"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="2dp">

                    <ImageView
                        android:id="@+id/tv_minus"
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:background="@drawable/bg_qty_btn"
                        android:contentDescription="减少数量"
                        android:padding="6dp"
                        android:src="@drawable/ic_minus"
                        app:tint="@color/colorTextSecondary" />

                    <TextView
                        android:id="@+id/tv_quantity"
                        android:layout_width="34dp"
                        android:layout_height="28dp"
                        android:gravity="center"
                        android:includeFontPadding="false"
                        android:text="1"
                        android:textColor="@color/colorTextPrimary"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <ImageView
                        android:id="@+id/tv_plus"
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:background="@drawable/bg_qty_btn"
                        android:contentDescription="增加数量"
                        android:padding="6dp"
                        android:src="@drawable/ic_plus"
                        app:tint="@color/colorPrimary" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</androidx.cardview.widget.CardView>
